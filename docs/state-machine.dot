// TCP connection state machine for tcp-sans-io.
//
// This is the authoritative, implementation-accurate transition graph. Its
// edges are exactly the relation of `State::debug_transition_allowed()` in
// src/state.rs: every fuzz target panics on a transition it does not allow,
// and a unit test in src/state.rs fails if this file draws a different set
// of edges, so the picture and the code cannot drift apart. Transition sites
// live in src/tcb/ (input.rs, ack.rs, cookie.rs, timers.rs, mod.rs).
//
// Regenerate the SVG after editing:
//   dot -Tsvg docs/state-machine.dot -o docs/state-machine.svg
//
// Legend:
//   solid black   normal protocol transition (trigger / action)
//   bold purple   SYN_RCVD -> LISTEN revert: the half-open slot is recycled
//                 (bounded SYN-ACK retransmit budget, or an exact RST)
//   green         SYN-cookie promotion: a valid cookie ACK establishes the
//                 connection with no prior state
//   dashed grey   abort: RST received, local abort(), or a timeout -> CLOSED
//
digraph tcp_state_machine {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.08"];
    edge [fontname="Helvetica", fontsize=9];

    // ---- States (colour-grouped by phase) -------------------------------
    Closed      [fillcolor="#e8e8e8", label="CLOSED"];
    Listen      [fillcolor="#d6f0f5", label="LISTEN"];
    SynSent     [fillcolor="#cfe6ff", label="SYN_SENT"];
    SynRcvd     [fillcolor="#cfe6ff", label="SYN_RCVD"];
    Established  [fillcolor="#cdeccd", label="ESTABLISHED"];
    FinWait1    [fillcolor="#f6e7b6", label="FIN_WAIT_1"];
    FinWait2    [fillcolor="#f6e7b6", label="FIN_WAIT_2"];
    Closing     [fillcolor="#f6e7b6", label="CLOSING"];
    TimeWait    [fillcolor="#f3d6a6", label="TIME_WAIT"];
    CloseWait   [fillcolor="#f6e7b6", label="CLOSE_WAIT"];
    LastAck     [fillcolor="#f6e7b6", label="LAST_ACK"];

    // ---- Opens ----------------------------------------------------------
    Closed   -> SynSent     [label="connect()\n/ send SYN"];
    Closed   -> Listen      [label="listen()"];
    Listen   -> SynRcvd     [label="recv SYN\n/ send SYN-ACK"];
    SynSent  -> Established  [label="recv SYN-ACK\n/ send ACK"];
    SynSent  -> SynRcvd     [label="recv SYN (simultaneous open)\n/ send SYN-ACK"];
    SynRcvd  -> Established  [label="recv ACK (3rd), or another\npeer's valid cookie ACK"];
    SynRcvd  -> CloseWait   [label="3rd ACK carries FIN\n/ send ACK"];
    TimeWait -> Listen      [label="listen()"];

    // Hybrid SYN cookies: while the half-open slot is busy, other peers get
    // stateless cookie SYN-ACKs. A valid cookie ACK establishes directly —
    // from LISTEN, or from SYN_RCVD by taking over the pending half-open.
    Listen   -> Established [label="recv valid cookie ACK",
                             color="#1f7a4d", fontcolor="#1f7a4d"];
    Listen   -> CloseWait   [label="valid cookie ACK\ncarrying FIN",
                             color="#1f7a4d", fontcolor="#1f7a4d"];

    // The half-open slot is recycled back to LISTEN after its bounded
    // SYN-ACK retransmit budget, or by a RST exactly at RCV.NXT (any other
    // in-window RST only draws a challenge ACK, RFC 5961).
    SynRcvd  -> Listen      [label="SYN-ACK budget exhausted\nor exact RST (listener)",
                             color="#7b2fbe", fontcolor="#7b2fbe", penwidth=2.0];

    // ---- Active close (we call close() first) ---------------------------
    Established -> FinWait1 [label="close()\n/ send FIN"];
    SynRcvd     -> FinWait1 [label="close()\n/ send FIN"];
    FinWait1 -> FinWait2    [label="recv ACK of FIN"];
    FinWait1 -> Closing     [label="recv FIN\n(simultaneous close)"];
    FinWait1 -> TimeWait    [label="recv FIN+ACK\n(both at once)"];
    FinWait2 -> TimeWait    [label="recv FIN\n/ send ACK"];
    Closing  -> TimeWait    [label="recv ACK of FIN"];
    TimeWait -> Closed      [label="2*MSL timeout"];

    // ---- Passive close (peer FINs first) --------------------------------
    Established -> CloseWait [label="recv FIN\n/ send ACK"];
    CloseWait   -> LastAck   [label="close()\n/ send FIN"];
    LastAck     -> Closed    [label="recv ACK of FIN"];

    // ---- Aborts: RST received / abort() / timeouts -> CLOSED ------------
    edge [style=dashed, color="#999999", fontcolor="#999999"];
    SynSent     -> Closed [label="RST / SYN retries\n/ abort()"];
    SynRcvd     -> Closed [label="RST (non-listener)\n/ abort()"];
    Listen      -> Closed [label="close() / abort()"];
    Established -> Closed [label="RST / abort()\n/ R2, USER TIMEOUT, keepalive"];
    FinWait1    -> Closed [label="RST / abort()\n/ R2, USER TIMEOUT"];
    FinWait2    -> Closed [label="RST / abort()\n/ FIN_WAIT_2 timeout"];
    Closing     -> Closed [label="RST / abort() / R2"];
    CloseWait   -> Closed [label="RST / abort()\n/ R2, USER TIMEOUT"];

    // ---- Rank hints for a clean top-to-bottom flow ----------------------
    { rank=same; SynSent; SynRcvd; }
    { rank=same; FinWait1; CloseWait; }
    { rank=same; FinWait2; Closing; }
}
